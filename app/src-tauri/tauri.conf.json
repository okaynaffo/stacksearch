{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StackSearch",
  "version": "0.1.0",
  "identifier": "app.stacksearch.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "beforeDevCommand": "",
    "beforeBuildCommand": "cd ui && npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8000 http://localhost:8000; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}